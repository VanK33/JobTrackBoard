{
  "name": "@platform/core",
  "version": "1.0.0",
  "description": "Core platform services - the motherboard for all modules",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch src/backend/index.ts",
    "dev:frontend": "vite",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "mkdir -p dist && cp -r src/backend dist/ && cp -r src/shared dist/",
    "build:frontend": "vite build",
    "start": "tsx dist/backend/index.ts",
    "test": "jest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@types/multer": "^2.0.0",
    "@types/pg": "^8.15.5",
    "@uiw/react-md-editor": "^4.0.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.18.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "^6.0.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "redis": "^4.6.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.13.0",
    "turndown": "^7.2.1",
    "winston": "^3.10.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.0.0",
    "jest": "^29.0.0",
    "tsx": "^4.0.0",
    "vite": "^5.0.0"
  }
}
