{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist/backend",
    "rootDir": "../../",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": [
    "src/backend/**/*",
    "../../shared/types/src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/frontend"
  ]
}