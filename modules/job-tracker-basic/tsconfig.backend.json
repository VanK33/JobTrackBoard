{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist/backend",
    "rootDir": "src/backend",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/backend/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}